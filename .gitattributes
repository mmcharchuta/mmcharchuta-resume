# LaTeX source files
*.tex text diff=latex
*.cls text diff=latex
*.sty text diff=latex

# Binary files
*.pdf binary
*.xdv binary
*.aux binary
*.fdb_latexmk binary
*.fls binary
*.log binary
*.out binary

# Font files
fonts/** binary

# PowerShell scripts.
# These are plain UTF-8. Do NOT add working-tree-encoding=UTF-16LE-BOM here:
# the files on disk are not UTF-16, so git stores mojibake and "git add"
# fails with "failed to encode ... from UTF-16LE-BOM to UTF-8".
*.ps1 text eol=crlf

# Hook scripts run under sh and must keep LF endings.
tools/pre-commit text eol=lf

# GitHub Actions
.github/** text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Configuration files
latexmkrc text diff=bash eol=lf
